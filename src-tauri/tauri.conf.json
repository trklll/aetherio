{
"productName": "Aetherio",
  "version": "0.6.1",
  "identifier": "com.aetherio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aetherio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000ff",
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Aetherio",
        "url": "index.html?window=splash",
        "width": 560,
        "height": 380,
        "minWidth": 560,
        "minHeight": 380,
        "maxWidth": 560,
        "maxHeight": 380,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0b0b0cff",
        "center": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https: wss: ws://localhost:*; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; media-src 'self' http://127.0.0.1:* https:; frame-src https:; worker-src 'self' blob:; child-src 'self' blob: https:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aetherio"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQzU3RjhFNEQ3OTlFREIKUldUYm5ubE5qbi9Gb0lGZFdZcnMrMW5Tc1ZxM3ZFY1Q5UGJuTm8rNUVXREowRlZZQ2RYUGhuSmwK",
      "endpoints": [
        "https://trkll.aetherio.workers.dev/api/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "3gp",
          "avi",
          "divx",
          "flv",
          "m2ts",
          "m4v",
          "mkv",
          "mov",
          "mp4",
          "mpeg",
          "mpg",
          "mts",
          "ogm",
          "rm",
          "rmvb",
          "ts",
          "vob",
          "webm",
          "wmv"
        ],
        "name": "Video de Aetherio",
        "description": "Archivo multimedia compatible con Aetherio",
        "role": "Viewer"
      }
    ],
    "licenseFile": "nsis/LICENSE.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/installer-hooks.nsh",
        "startMenuFolder": "Aetherio"
      }
    },
    "resources": [
      "bin/mpv"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
